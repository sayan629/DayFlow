generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskPriority {
  low
  medium
  high
}

enum TaskCategory {
  study
  development
  personal
  fitness
  other
}

enum FocusMode {
  focus
  shortBreak
  longBreak
}

enum AlarmStatus {
  ringing
  snoozed
  stopped
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  passwordHash    String
  avatar          String?
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions                Session[]
  tasks                   Task[]
  focusSessions           FocusSession[]
  alarmHistory            AlarmHistory[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Task {
  id           String       @id
  userId       String?
  title        String
  description  String?
  date         String
  startTime    String?
  endTime      String?
  priority     TaskPriority @default(medium)
  category     TaskCategory @default(other)
  completed    Boolean      @default(false)
  reminder     Int?
  alarmEnabled Boolean      @default(true)
  snoozedUntil DateTime?
  createdAt    DateTime     @default(now())

  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  focusSessions FocusSession[]
  alarmHistory  AlarmHistory[]

  @@index([userId])
  @@index([date])
  @@index([completed])
}

model FocusSession {
  id              String    @id
  userId          String?
  taskId          String?
  taskTitle       String?
  mode            FocusMode
  durationSeconds Int
  startedAt       DateTime
  completedAt     DateTime

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([taskId])
  @@index([completedAt])
}

model AlarmHistory {
  id           String      @id
  userId       String?
  taskId       String?
  taskTitle    String
  status       AlarmStatus
  triggeredAt  DateTime
  stoppedAt    DateTime?
  snoozedUntil DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([taskId])
  @@index([triggeredAt])
}
